<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#ECECF0" />
            <stroke android:width="1dp" android:color="#E2E2E8" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E1DFF2" />
            <stroke android:width="1dp" android:color="#CBC6F3" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F7F7F9" />
            <stroke android:width="1dp" android:color="#DDDDE5" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
